# Environment Template for SmartAlarms API

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ENV=int

# Logging
LOG_LEVEL=INFO

# ITSM integration
ITSM_BASE_URL=https://api.int.gcp.bmw.cloud/nowplatform/v1
ITSM_HOST=api.int.gcp.bmw.cloud
ITSM_AUTHORIZATION=
ITSM_API_KEY=
ITSM_TIMEOUT_SECONDS=10

# LLM Gateway Configuration (GAIA)
GAIA_LLM_ENDPOINT="https://api.int.gcp.cloud.bmw/llmapi/v1"
GAIA_MODEL="openai/gpt-5"
GAIA_AUTH_ENDPOINT="https://auth-i.bmwgroup.net/auth/oauth2/realms/root/realms/machine2machine/access_token"
LLM_API_KEY=""          # OAuth2 client_id (from webEAM-Token JSON field "client_id")
LLM_CLIENT_SECRET=""    # OAuth2 client_secret (from webEAM-Token JSON field "client_secret")
LLM_X_API_KEY=""        # x-apikey gateway header — equivalent to LLM-API-Key in despresso1.
                        # If left empty, falls back to LLM_API_KEY (client_id).
CA_CERT_PATH=/path/to/ca/bundle.pem
CA_CERT_URL=https://ca.url/bundle.pem

# LLM Gateway Optional Settings
LLM_GATEWAY_ENABLED=true
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_DEFAULT_MAX_TOKENS=100000
LLM_REQUEST_TIMEOUT_SECONDS=240.0
LLM_AUTH_TIMEOUT_SECONDS=30.0

# Related incident historical context
RELATED_INCIDENTS_MAX_SAME_TITLE=100
RELATED_INCIDENTS_RECENT_SAME_TITLE_LIMIT=10
RELATED_INCIDENTS_INCLUDE_COMMENTS=true
RELATED_INCIDENTS_INCLUDE_WORK_NOTES=true

# Observability / Langfuse
TRACING_ENABLED=true
LANGFUSE_BASE_URL=https://langfuse.swf.bmwgroup.net
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
OTEL_SERVICE_NAME=smartalarms-api
