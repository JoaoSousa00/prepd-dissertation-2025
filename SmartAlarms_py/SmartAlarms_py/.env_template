# Environment Template for SmartAlarms API

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ENV=development

# Logging
LOG_LEVEL=INFO

# ITSM integration
ITSM_BASE_URL=https://api.int.gcp.bmw.cloud/nowplatform/v1
ITSM_HOST=api.int.gcp.bmw.cloud
ITSM_AUTHORIZATION=
ITSM_API_KEY=
ITSM_TIMEOUT_SECONDS=10

# LLM Gateway Configuration (GAIA)
GAIA_LLM_ENDPOINT=https://gaia.api/v1
GAIA_MODEL=gpt-4
GAIA_AUTH_ENDPOINT=https://auth.api/token
LLM_API_KEY=
LLM_CLIENT_SECRET=
LLM_X_API_KEY=
CA_CERT_PATH=/path/to/ca/bundle.pem
CA_CERT_URL=https://ca.url/bundle.pem

# LLM Gateway Optional Settings
LLM_GATEWAY_ENABLED=true
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=1.0
LLM_DEFAULT_MAX_TOKENS=2048
LLM_REQUEST_TIMEOUT_SECONDS=30.0
LLM_AUTH_TIMEOUT_SECONDS=10.0
