{
  "openapi": "3.1.0",
  "info": {
    "title": "SmartAlarms API",
    "version": "v1",
    "description": "API contract for incident analysis and incident detail enrichment. Incident analysis is performed through the GET details endpoint.\n"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Incidents",
      "description": "Incident detail enrichment and analysis operations"
    }
  ],
  "paths": {
    "/incident/details": {
      "get": {
        "tags": ["Incidents"],
        "summary": "Fetches and analyzes specified incidents",
        "description": "Returns incident details and analysis-relevant enrichment from related incidents and log events for a list of incident identifiers.\n",
        "operationId": "getIncidentDetailsAndAnalysis",
        "parameters": [
          {
            "name": "incidentIds",
            "in": "query",
            "required": true,
            "description": "List of incident identifiers",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "example": "INC000000000000"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval and analysis containing one or more results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailsResponse"
                }
              }
            }
          },
          "204": {
            "description": "The requested incidents were not found"
          },
          "400": {
            "description": "The incoming request did not pass input validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResolutionSuggestion": {
        "type": "object",
        "description": "Structured mitigation suggestion with confidence, actions, resolution note, and source evidence",
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "type": "string",
            "description": "Suggestion confidence label: evidence-based or reasoned fallback",
            "example": "evidence-based"
          },
          "investigation": {
            "type": "string",
            "description": "Investigation step for this suggestion",
            "example": "Check worker queue depth and backlog growth for the impacted service."
          },
          "mitigation": {
            "type": "string",
            "description": "Mitigation step for this suggestion",
            "example": "Restart impacted worker pods and confirm queue drain."
          },
          "resolutionNote": {
            "type": "string",
            "description": "Suggested resolution note text for incident closure",
            "example": "Restarted impacted worker pods, queue depth normalized, and throughput recovered."
          },
          "relatedIncidents": {
            "type": "array",
            "description": "The list of incidents that led to this suggestion",
            "items": {
              "type": "string"
            },
            "example": ["INC000000000001", "INC000000000002"]
          }
        }
      },
      "LlmUsageData": {
        "type": "object",
        "description": "LLM usage and estimated cost metadata",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "description": "Model name used for the LLM request",
            "example": "openai/gpt-5"
          },
          "tokensIn": {
            "type": "integer",
            "description": "Prompt token count",
            "example": 120
          },
          "tokensOut": {
            "type": "integer",
            "description": "Completion token count",
            "example": 80
          },
          "tokensTotal": {
            "type": "integer",
            "description": "Total token count",
            "example": 200
          },
          "cost_USD": {
            "type": "number",
            "description": "Monetary cost in USD",
            "example": 0.0123
          }
        }
      },
      "DetailsResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "incidents": {
            "type": "array",
            "description": "List with incident details",
            "items": {
              "$ref": "#/components/schemas/IncidentData"
            }
          }
        }
      },
      "IncidentData": {
        "type": "object",
        "description": "Contains additional information about an incident",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique incident identifier",
            "example": "INC000000000000"
          },
          "shortDescription": {
            "type": "string",
            "description": "A small description of what the incident is about",
            "example": "An increase of cpu was observed due to a high number of requests to the path /endpoint"
          },
          "description": {
            "type": "string",
            "description": "A broader description with incident context",
            "example": "The tasks from ECS of the service billing-api were increasing CPU usage due to high requests."
          },
          "summary": {
            "type": "string",
            "description": "Natural-language summary generated for the incident",
            "example": "The billing API is experiencing elevated CPU due to request spikes on /endpoint."
          },
          "relatedIncidents": {
            "type": "array",
            "description": "Related incident references when available",
            "items": {
              "type": "string"
            },
            "example": ["INC000000000001", "INC000000000002"]
          },
          "resolutionSuggestions": {
            "type": "array",
            "description": "The list of ordered suggestions to mitigate the incident",
            "items": {
              "$ref": "#/components/schemas/ResolutionSuggestion"
            }
          },
          "llmUsage": {
            "$ref": "#/components/schemas/LlmUsageData"
          },
          "requestLatencyMs": {
            "type": "number",
            "description": "End-to-end latency for generating the incident details"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "example": "Invalid request payload"
          },
          "code": {
            "type": "string",
            "example": "BAD_REQUEST"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
